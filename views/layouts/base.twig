<!doctype html>
<!--suppress HtmlRequiredTitleElement, HtmlRequiredLangAttribute -->
<html {{ site.language_attributes }}>
  <head>
    <meta charset='UTF-8'>
    <meta name='viewport'
          content='width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0'>

    {% include 'views/partials/seo.twig' with { seo: post.fields.seo_metadata } %}

    {% for provider in analytics %}
      {% include 'views/partials/analytics/' ~ provider.type ~ '.twig' with { analytics_id: provider.id } only %}
    {% endfor %}

    {{ function('wp_head') }}
  </head>
  <body {{ function('body_class') }}>
    {% for provider in analytics %}
      {% if provider.type in ['gtm', 'meta'] %}
        {% include 'views/partials/analytics/noscript/' ~ provider.type ~ '.twig' with { analytics_id: provider.id } only %}
      {% endif %}
    {% endfor %}

    {{ function('wp_body_open') }}

    {% include 'views/partials/header.twig' %}

    <main id="main-content">
      {% block content %}{% endblock %}
    </main>

    {% include 'views/partials/footer.twig' %}

    {{ function('wp_footer') }}
  </body>
</html>